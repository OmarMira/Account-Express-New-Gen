generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String   @default("company_admin") // super_admin | company_admin
  isActive     Boolean  @default(true)
  phone        String   @default("")
  streetLine1  String   @default("")
  streetLine2  String   @default("")
  city         String   @default("")
  state        String   @default("")
  zipCode      String   @default("")
  avatar       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyMemberships    CompanyMember[]
  reconciliationPeriods ReconciliationPeriod[] @relation("ReconUser")
  auditLogs             AuditLog[]
  sessions              Session[]
}

model Company {
  id        String   @id @default(cuid())
  legalName String
  taxId     String?
  address   String?
  phone     String?
  email     String?
  logo      String?
  streetLine1          String   @default("")
  streetLine2          String   @default("")
  city                 String   @default("")
  state                String   @default("")
  zipCode              String   @default("")
  isActive           Boolean  @default(true)
  isOnboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members        CompanyMember[]
  glAccounts     GlAccount[]
  bankAccounts   BankAccount[]
  bankRules      BankRule[]
  journalEntries JournalEntry[]
  fiscalPeriods  FiscalPeriod[]
  statements           BankStatement[]
  reconciliationPeriods ReconciliationPeriod[]
  auditLogs            AuditLog[]
  entityContexts       EntityContext[]
  systemMemories       SystemMemory[]
}

model CompanyMember {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("company_admin") // company_admin
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model GlAccount {
  id            String   @id @default(cuid())
  companyId     String
  code          String
  name          String
  accountType   String   // asset | liability | equity | revenue | expense
  normalBalance String   // debit | credit
  parentId      String?
  isActive      Boolean  @default(true)
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       GlAccount?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     GlAccount[]     @relation("AccountHierarchy")
  journalLines JournalLine[]
  bankAccounts BankAccount[]
  bankRules          BankRule[]        @relation("LegacyRuleGlAccount")
  debitBankRules     BankRule[]        @relation("DebitRuleGlAccount")
  creditBankRules    BankRule[]        @relation("CreditRuleGlAccount")
  transactions BankTransaction[]
  entityContexts EntityContext[]

  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@index([companyId, accountType])
}

model BankAccount {
  id          String   @id @default(cuid())
  companyId   String
  accountName String
  bankName    String
  accountNo   String?
  routingNo   String?
  glAccountId String
  balance        Float    @default(0)
  initialBalance Float    @default(0)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  glAccount  GlAccount              @relation(fields: [glAccountId], references: [id])
  statements BankStatement[]
  reconciliationPeriods ReconciliationPeriod[]

  @@index([companyId])
  @@index([glAccountId])
  @@index([companyId, accountNo])
}

model BankStatement {
  id            String   @id @default(cuid())
  companyId     String
  bankAccountId String
  startDate     DateTime
  endDate       DateTime
  openingBalance Float
  closingBalance Float
  totalCredits  Float    @default(0)
  totalDebits   Float    @default(0)
  format        String   // csv | ofx | qfx | pdf
  fileName      String?
  createdAt     DateTime @default(now())

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([bankAccountId, startDate, endDate])
  @@index([bankAccountId, endDate])
}

model BankTransaction {
  id              String    @id @default(cuid())
  statementId     String
  date            DateTime
  description     String
  amount          Float
  reference       String?
  isReconciled    Boolean   @default(false)
  glAccountId     String?
  matchedRuleId   String?
  reconciledAt    DateTime?
  reconciliationPeriodId String?
  importHash      String?   @unique  // SHA-256 para idempotencia en importación
  journalLineId   String?   @unique  // Vínculo a JournalLine para evitar doble conteo
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  statement             BankStatement          @relation(fields: [statementId], references: [id], onDelete: Cascade)
  glAccount             GlAccount?             @relation(fields: [glAccountId], references: [id])
  matchedRule           BankRule?              @relation(fields: [matchedRuleId], references: [id])
  reconciliationPeriod  ReconciliationPeriod?  @relation(fields: [reconciliationPeriodId], references: [id])

  @@index([statementId])
  @@index([glAccountId])
  @@index([isReconciled])
  @@index([statementId, isReconciled, date])
  @@index([reference])
  @@index([statementId, date])
  @@index([importHash])
  @@index([isReconciled, journalLineId, date]) // Optimiza query de flujo contable
}

model ReconciliationPeriod {
  id              String   @id @default(cuid())
  companyId       String
  bankAccountId   String
  userId          String
  statementBalance Float   @default(0)
  bookBalance     Float    @default(0)
  difference      Float    @default(0)
  status          String   @default("open") // open | completed | cancelled
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  transactionCount  Int    @default(0)
  notes           String?

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User              @relation("ReconUser", fields: [userId], references: [id])
  bankAccount BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([companyId, bankAccountId])
  @@index([status])
}

model BankRule {
  id                   String      @id @default(cuid())
  companyId            String
  company              Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String
  
  // v1 legacy fields (kept for migration safety)
  conditionType        String
  conditionValue       String
  transactionDirection String      @default("any") // "any", "debit", "credit"
  glAccountId          String?
  glAccount            GlAccount?  @relation("LegacyRuleGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  
  // v2 composite fields
  conditions           Json?       // Array of Condition objects
  debitGlAccountId     String?
  debitGlAccount       GlAccount?  @relation("DebitRuleGlAccount", fields: [debitGlAccountId], references: [id], onDelete: SetNull)
  creditGlAccountId    String?
  creditGlAccount      GlAccount?  @relation("CreditRuleGlAccount", fields: [creditGlAccountId], references: [id], onDelete: SetNull)
  
  priority             Int         @default(10)
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  transactions         BankTransaction[]

  @@index([companyId, isActive, priority])
}

model JournalEntry {
  id          String   @id @default(cuid())
  companyId   String
  date        DateTime
  description String
  reference   String?
  status      String   @default("draft") // draft | posted | void
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  @@index([companyId, date])
}

model JournalLine {
  id          String   @id @default(cuid())
  entryId     String
  glAccountId String
  description String?
  debit       Float    @default(0)
  credit      Float    @default(0)

  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  glAccount GlAccount    @relation(fields: [glAccountId], references: [id])

  @@index([entryId])
  @@index([glAccountId])
  @@index([glAccountId, entryId])
}

model FiscalPeriod {
  id        String   @id @default(cuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([companyId])
  @@index([createdAt])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, expiresAt])
}

model EntityContext {
  id          String   @id @default(cuid())
  companyId   String
  pattern     String
  role        String
  glAccountId String?
  source      String   @default("user") // user | ai
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  glAccount  GlAccount? @relation(fields: [glAccountId], references: [id], onDelete: SetNull)

  @@unique([companyId, pattern])
  @@index([companyId])
}

model SystemMemory {
  id             String    @id @default(cuid())
  companyId      String
  type           String    // 'preference' | 'decision' | 'fact' | 'rule_context'
  title          String
  content        String
  keywords       String    // CSV: "omar,mira,socio"
  importance     Int       @default(5) // Prioridad: escala 1 a 10 (10 = crítico)
  accessCount    Int       @default(0) // Contador de lecturas
  lastAccessedAt DateTime? // Fecha de última lectura para frescura
  embedding      String?   // Reservado para Level 2 (JSON String de float[])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([type])
  @@index([importance])
}

model BankProfile {
  id             String   @id @default(cuid())
  bankId         String   @unique
  bankName       String
  fingerprints   String   // Array de strings guardado como JSON string (ej. '["Bank of America", "BOA"]')
  isActive       Boolean  @default(true)
  requiresReview Boolean  @default(false)
  config         String   // Configuración JSON de parseo (layoutType, rules, numberFormat, tolerance...)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([requiresReview])
}

